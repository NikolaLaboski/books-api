generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// This is our "Book" table
model Book {
  id        Int      @id @default(autoincrement())
  title     String
  author    String
  year      Int?
  createdAt DateTime @default(now())
}
